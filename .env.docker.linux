# Linux 服务器 Docker/Compose + Nginx 部署配置模板
# 使用方式：
#   cp .env.docker.linux .env
#   vim .env
#   mkdir -p /data/ccsdk
#   chown -R 1000:1000 /data/ccsdk
#   docker build -t ccsdk-sandbox:latest .
#   docker compose up -d --no-build --force-recreate

# Anthropic / 兼容 Anthropic API 配置
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent SDK 服务配置
AGENT_SDK_FIRST_OUTPUT_TIMEOUT_MS=30000
AGENT_SDK_API_KEY=
AGENT_SDK_PORT=8000
AGENT_SDK_PERMISSIONS_ALLOW=WebSearch(web search:*),WebFetch(domain:*)
HOST=0.0.0.0
PORT=8000

# Docker 启动 API 服务时，WORK_DIR 必须是宿主 Docker daemon 和 API 容器都可见的同一路径。
# Nginx 也应 alias 到这个目录。
WORK_DIR=/data/ccsdk
CLAUDE_OUTPUT_DIR=/data/ccsdk
CLAUDE_OUTPUT_BASE_URL=http://your-domain-or-ip/files/ccsdk

# 沙箱空间目录必须位于 CLAUDE_OUTPUT_DIR 下，便于 Nginx 暴露产物。
VIRTUAL_SPACE_DIR=/data/ccsdk/virtual_spaces

# Docker Compose/API 容器启动时，模板源目录固定为镜像内 /app。
VIRTUAL_SPACE_SOURCE_DIR=/app
VIRTUAL_SPACE_APP_PATHS=app,pyproject.toml,requirements.txt,README.md
VIRTUAL_SPACE_CLAUDE_FILES=CLAUDE.md,settings.json
VIRTUAL_SPACE_ENABLED=false

# Skills 在镜像内固定为 /app/.claude/skills；Compose 中也会固定注入该值。
SKILLS_DIR=/app/.claude/skills

# Session 元数据持久化。保存 conversationId -> resume_id / virtual_space 等映射。
SESSION_STORE=file
SESSION_FILE_PATH=/data/ccsdk/.claude/sessions.json
SESSION_DB_DSN=
SESSION_ISOLATED_WORKDIR=false

# Docker 沙箱
SANDBOX_ENABLED=true
SANDBOX_RUNTIME=docker
SANDBOX_IMAGE=ccsdk-sandbox:latest
SANDBOX_NETWORK=bridge
SANDBOX_MEMORY=2g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_TMPFS_SIZE=256m
SANDBOX_TIMEOUT_SECONDS=900
SANDBOX_READ_ONLY_ROOTFS=true

# 沙箱容器非 root 运行；确保 /data/ccsdk 对该 UID/GID 可写。
SANDBOX_UID=1000
SANDBOX_GID=1000

# 安全模式。若 skills 需要写文件，通常保留禁 Bash、放开 Write。
GLOBAL_DISALLOWED_TOOLS=Bash

# Skill 业务环境变量透传。只会把白名单变量传入一次性 sandbox 容器。
SANDBOX_ENV_PASSTHROUGH=ARK_API_KEY,MINIMAX_API_KEY
ARK_API_KEY=
MINIMAX_API_KEY=

# Nginx 参考：
# location /files/ccsdk/ {
#     alias /data/ccsdk/;
#     add_header Access-Control-Allow-Origin *;
#     add_header Accept-Ranges bytes;
# }
#
# 沙箱内输出:
#   /sandbox/workspace/output/final_video.mp4
# 宿主真实路径:
#   /data/ccsdk/virtual_spaces/<safe-space-key>/workspace/output/final_video.mp4
# 前端访问 URL:
#   http://your-domain-or-ip/files/ccsdk/virtual_spaces/<safe-space-key>/workspace/output/final_video.mp4
