# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# Anthropic API 配置
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_AUTH_TOKEN=your-api-key-here
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent SDK 配置
AGENT_SDK_FIRST_OUTPUT_TIMEOUT_MS=30000
AGENT_SDK_API_KEY=
AGENT_SDK_PORT=8000

# （可选）开启 Claude Code 内置联网工具（搜索/抓取）
# - WebSearch：联网搜索
# - WebFetch：抓取指定域名内容（domain:* 表示不限制域名，按需收紧）
AGENT_SDK_PERMISSIONS_ALLOW=WebSearch(web search:*),WebFetch(domain:*)

# 服务配置
HOST=0.0.0.0
PORT=8000

# 目录配置
WORK_DIR=/workspace
SKILLS_DIR=./skills
