# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# Anthropic API 配置
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_AUTH_TOKEN=your-api-key-here
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent SDK 配置
AGENT_SDK_FIRST_OUTPUT_TIMEOUT_MS=30000
AGENT_SDK_API_KEY=
# AGENT_SDK_PORT=8000

# （可选）开启 Claude Code 内置联网工具（搜索/抓取）
# - WebSearch：联网搜索
# - WebFetch：抓取指定域名内容（domain:* 表示不限制域名，按需收紧）
AGENT_SDK_PERMISSIONS_ALLOW=WebSearch(web search:*),WebFetch(domain:*)

# 服务配置
HOST=0.0.0.0
PORT=8000

# 目录配置
WORK_DIR=/workspace
SKILLS_DIR=./skills

# 安全模式：全局强制禁用的工具，逗号分隔
# 默认禁用 Write 和 Bash，防止服务端落盘或执行任意命令
# 只禁 Bash（允许写文件）：GLOBAL_DISALLOWED_TOOLS=Bash
# 全部放开：GLOBAL_DISALLOWED_TOOLS=
GLOBAL_DISALLOWED_TOOLS=Write,Bash

# Session 存储模式
# - memory：纯内存，重启后丢失（默认，适合测试/无状态场景）
# - file：持久化到 JSON 文件，重启后自动恢复（适合单机长期对话）
# - db：持久化到数据库，支持多 Worker（适合生产环境，需配置 SESSION_DB_DSN）
SESSION_STORE=memory

# file 模式下的持久化文件路径（SESSION_STORE=file 时生效）
SESSION_FILE_PATH=./.claude/sessions.json

# db 模式下的数据库连接串（SESSION_STORE=db 时生效）
# 示例：mysql+asyncmy://user:pass@host:3306/dbname
SESSION_DB_DSN=

# 是否按 conversationId 自动隔离工作目录
# true：未传 cwd 时自动使用 <WORK_DIR>/sessions/<conversationId>/ 作为工作目录
#       适合多用户场景，每个会话的生成文件完全隔离
# false（默认）：所有会话共享 WORK_DIR
# 前端也可在请求里显式传 cwd 覆盖此配置（优先级更高）
SESSION_ISOLATED_WORKDIR=false

# =============================================================================
# RAG 知识库问答配置
# =============================================================================

# 是否启用 RAG 功能
RAG_ENABLED=true

# RAG 本地状态存储目录
# 默认: ${WORK_DIR}/rag
# 当前 local vector store 会把 fileSet、knowledgeBase、chunk、embedding snapshot 到 rag.db
RAG_STORAGE_DIR=./rag

# 临时 fileSet 保留时间，单位小时
RAG_TEMP_FILE_TTL_HOURS=24

# direct tool-loop 超时/ token（仅 RagAgentRunner.stream_direct 内部实现使用；HTTP 流式接口未接入）
RAG_DIRECT_TIMEOUT_SECONDS=120
RAG_DIRECT_MAX_TOKENS=2048

# RAG 向量库配置
# 当前真实可用: local，local就是sqlite3
# qdrant / pgvector / milvus 当前为预留配置，尚未实现真实 provider
RAG_VECTOR_PROVIDER=local
RAG_QDRANT_URL=
RAG_PGVECTOR_DSN=
RAG_MILVUS_URI=

# RAG Embedding 配置
# 当前默认本地 hash embedding 可用于开发和测试
# openai_compatible 为后续真实 embedding provider 预留
RAG_EMBEDDING_PROVIDER=openai_compatible
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=

# RAG 文档解析器配置
# local：本地解析 .txt/.md/.pdf/.docx；适合开发或无 MinerU 环境
# mineru：.txt/.md 仍本地解析，.pdf/.docx 调用 MinerU 服务；生产推荐
RAG_PARSER_PROVIDER=local
MINERU_BASE_URL=
MINERU_API_KEY=
MINERU_TIMEOUT_SECONDS=120
# 生产推荐 false：MinerU 失败时单文件失败；开发可设 true 回退本地解析
MINERU_FALLBACK_TO_LOCAL=false

# RAG 上传限制
# 默认允许 .txt/.md/.pdf/.docx；如需收窄或扩展格式可显式覆盖
RAG_ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx
RAG_MAX_UPLOAD_FILES=5
RAG_MAX_UPLOAD_SIZE_MB=20

# RAG Chunk / Retrieval
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=8
RAG_MAX_TOP_K=30

# RAG 并发限制
RAG_MAX_CONCURRENT_INGESTIONS=4
RAG_MAX_CONCURRENT_QUERIES=16
