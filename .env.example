# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# Anthropic API 配置
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_AUTH_TOKEN=your-api-key-here
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent SDK 配置
AGENT_SDK_FIRST_OUTPUT_TIMEOUT_MS=30000
AGENT_SDK_API_KEY=
AGENT_SDK_PORT=8000

# （可选）开启 Claude Code 内置联网工具（搜索/抓取）
# - WebSearch：联网搜索
# - WebFetch：抓取指定域名内容（domain:* 表示不限制域名，按需收紧）
AGENT_SDK_PERMISSIONS_ALLOW=WebSearch(web search:*),WebFetch(domain:*)

# 服务配置
HOST=0.0.0.0
PORT=8000

# 目录配置
# 程序工作目录
WORK_DIR=/tmp/ccsdk-workspace
# 虚拟机沙箱模式无效，虚拟沙箱会直接打包进镜像里面
SKILLS_DIR=./.claude/skills
# 每个请求的沙箱空间优先使用请求参数 spaceId；未传 spaceId 时回退 conversationId，适合临时会话。
# 同一 spaceId 共享 workspace；同一 spaceId 内不同 conversationId 拥有各自 Claude HOME/历史。
# 这个地址必须是CLAUDE_OUTPUT_DIR/virtual_spaces
VIRTUAL_SPACE_DIR=/tmp/ccsdk-workspace/virtual_spaces
# 宿主侧输出根目录。Docker 沙箱内固定写 /sandbox/workspace；这里用于计算前端可访问 URL。
# 通常与 WORK_DIR 保持一致，并由 Nginx 静态暴露。
CLAUDE_OUTPUT_DIR=/tmp/ccsdk-workspace
CLAUDE_OUTPUT_BASE_URL=nginx映射地址到/tmp/ccsdk-workspace


# Docker 真实沙箱 - 必须关注/建议显式配置项（SANDBOX_ENABLED=true 时）
# true：Claude Agent SDK/CLI 在一次性 Docker 沙箱容器内运行，宿主服务只负责鉴权、会话和 SSE 转发。
SANDBOX_ENABLED=false
# 沙箱镜像必须提前构建，或由 docker compose build 构建出来。
SANDBOX_IMAGE=ccsdk-sandbox:latest
# 建议沙箱模式使用 file，避免 API 容器重启后 conversationId -> Claude resume_id 映射丢失。
SESSION_STORE=file
# 必须是CLAUDE_OUTPUT_DIR/.claude/sessions.json
SESSION_FILE_PATH=/tmp/ccsdk-workspace/.claude/sessions.json
# 容器内必须非 root；Docker Compose 中建议显式配置成可写 WORK_DIR 的宿主 UID/GID。
SANDBOX_UID=1000
SANDBOX_GID=1000

# 安全模式：全局强制禁用的工具，逗号分隔
# 默认禁用 Write 和 Bash，防止服务端落盘或执行任意命令
# 只禁 Bash（允许写文件）：GLOBAL_DISALLOWED_TOOLS=Bash
# 全部放开：GLOBAL_DISALLOWED_TOOLS=
GLOBAL_DISALLOWED_TOOLS=Write,Bash

# Skill 业务环境变量透传
# 先把业务密钥写在 .env，再把允许进入一次性沙箱容器的变量名加入白名单。
# 只透传白名单变量，不会把 API 容器全部环境变量暴露给 skills。
# 当前内置 skills 常用：ARK_API_KEY/MINIMAX_API_KEY。
SANDBOX_ENV_PASSTHROUGH=ARK_API_KEY,MINIMAX_API_KEY
ARK_API_KEY=
MINIMAX_API_KEY=

# Docker 真实沙箱 - 可选项（都有代码或 docker-compose 默认值）
SANDBOX_RUNTIME=docker
SANDBOX_NETWORK=bridge
SANDBOX_MEMORY=2g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_TMPFS_SIZE=256m
SANDBOX_TIMEOUT_SECONDS=900
SANDBOX_READ_ONLY_ROOTFS=true

# 沙箱文件系统模板 - 可选项
# SANDBOX_ENABLED=true 时会自动准备虚拟空间；VIRTUAL_SPACE_ENABLED 只用于不启用 Docker 时的目录级隔离。
VIRTUAL_SPACE_ENABLED=false
# VIRTUAL_SPACE_SOURCE_DIR 默认是项目根目录；Docker Compose 内固定为 /app。
# 会复制应用程序、.claude 配置和 skills 到 <VIRTUAL_SPACE_DIR>/<safe-space-key>/ 后挂载为容器 /sandbox。
# 容器内业务产物目录：/sandbox/workspace；Claude HOME：/sandbox/sessions/<safe-conversationId>/.home。
# cwd 不参与 Docker 沙箱隔离，只保留给非虚拟化本地工作目录模式使用。
VIRTUAL_SPACE_SOURCE_DIR=
VIRTUAL_SPACE_APP_PATHS=app,pyproject.toml,requirements.txt,README.md
VIRTUAL_SPACE_CLAUDE_FILES=CLAUDE.md,settings.json

# Session 存储 - 其他可选项
# SESSION_STORE 可选值：
# - memory：纯内存，重启后丢失，适合测试/无状态场景。
# - file：持久化到 JSON 文件，重启后自动恢复，沙箱模式推荐。
# - db：持久化到数据库，支持多 Worker；使用时把上方 SESSION_STORE 改为 db，并配置 SESSION_DB_DSN。
# db 模式下的数据库连接串。
# 示例：mysql+asyncmy://user:pass@host:3306/dbname
SESSION_DB_DSN=

# 是否按 conversationId 自动隔离工作目录
# true：未传 cwd 时自动使用 <WORK_DIR>/sessions/<conversationId>/ 作为工作目录
#       适合多用户场景，每个会话的生成文件完全隔离
# false（默认）：所有会话共享 WORK_DIR
# 前端也可在请求里显式传 cwd 覆盖此配置（优先级更高）
SESSION_ISOLATED_WORKDIR=false
