# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# Anthropic API 配置
ANTHROPIC_AUTH_TOKEN=your-api-key-here
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent SDK 配置
AGENT_SDK_FIRST_OUTPUT_TIMEOUT_MS=30000
AGENT_SDK_API_KEY=your-api-key-for-auth
AGENT_SDK_PORT=8000

# 服务配置
HOST=0.0.0.0
PORT=8000

# 目录配置
WORK_DIR=/workspace
SKILLS_DIR=./skills
